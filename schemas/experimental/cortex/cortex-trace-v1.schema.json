{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knolo.dev/schemas/experimental/cortex/cortex-trace-v1.schema.json",
  "title": "Knolo Cortex trace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "question", "questionDigest", "image", "policy", "rounds", "selectedEvidence", "answer", "receipt"],
  "properties": {
    "format": { "const": "knolo-cortex-trace-1" },
    "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "questionDigest": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "stateRoot"],
      "properties": {
        "kind": { "enum": ["v4-pack", "v5-image"] },
        "stateRoot": { "type": "string" },
        "commitDigest": { "type": "string" },
        "knowledgeRoot": { "type": "string" }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRounds", "maxCandidatesPerRound", "maxEvidenceInAnswer", "requireCitations", "allowSemanticRerank", "allowAbstain"],
      "properties": {
        "maxRounds": { "type": "integer", "minimum": 1, "maximum": 8 },
        "maxCandidatesPerRound": { "type": "integer", "minimum": 1, "maximum": 200 },
        "maxEvidenceInAnswer": { "type": "integer", "minimum": 1, "maximum": 32 },
        "requireCitations": { "type": "boolean" },
        "allowSemanticRerank": { "type": "boolean" },
        "allowAbstain": { "type": "boolean" }
      }
    },
    "rounds": { "type": "array", "minItems": 1, "maxItems": 8 },
    "selectedEvidence": { "type": "array", "maxItems": 32 },
    "karEvaluations": { "type": "array" },
    "karPlan": {},
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "text", "claims", "citations", "gaps"],
      "properties": {
        "status": { "enum": ["ANSWERED", "PARTIAL", "INSUFFICIENT_EVIDENCE"] },
        "text": { "type": "string", "maxLength": 8000 },
        "claims": { "type": "array" },
        "citations": { "type": "array" },
        "gaps": { "type": "array" }
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceRoot", "answerRoot", "evidenceRoot"],
      "properties": {
        "traceRoot": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "answerRoot": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "evidenceRoot": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "createdAt": { "type": "string", "maxLength": 64 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knolo.dev/schema/experimental/flight/flight-events-v1.schema.json",
  "title": "Flight events v1",
  "description": "Canonical discrete flight events for knolo flight ingest. This document is not a log parser and it is not a Committed Evidence Graph. log.format is ulog, dataflash, or rosbag2. Tokens, per-kind field keys, and sentence shapes match packages/cli/bin/flight.mjs. Ingest also checks sort order, duplicate ids, the byte range against the log, and exact sentence equality.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "parser", "log", "events"],
  "properties": {
    "format": { "const": "flight-events-1" },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byteLength", "format"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^sha256-[0-9a-f]{64}$" },
        "byteLength": { "$ref": "#/$defs/safeInteger" },
        "format": { "enum": ["ulog", "dataflash", "rosbag2"] }
      }
    },
    "events": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "phrase": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9 -]{0,160}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "timestampUs", "byteStart", "byteEnd", "fields", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/token" },
        "kind": {
          "enum": [
            "arming",
            "nav-mode",
            "failsafe-assert",
            "failsafe-clear",
            "geofence-breach",
            "geofence-clear",
            "battery-threshold",
            "link-loss",
            "link-restored",
            "scan-summary"
          ]
        },
        "timestampUs": { "$ref": "#/$defs/safeInteger" },
        "byteStart": { "$ref": "#/$defs/safeInteger" },
        "byteEnd": { "$ref": "#/$defs/safeInteger" },
        "fields": { "type": "object" },
        "text": { "type": "string", "minLength": 1 }
      },
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "arming" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["state"],
              "properties": { "state": { "$ref": "#/$defs/token" } }
            },
            "text": { "pattern": "^ARMING_STATE [A-Za-z0-9][A-Za-z0-9._-]{0,63} at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "nav-mode" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode"],
              "properties": { "mode": { "$ref": "#/$defs/token" } }
            },
            "text": { "pattern": "^NAV_STATE [A-Za-z0-9][A-Za-z0-9._-]{0,63} at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "failsafe-assert" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "$ref": "#/$defs/token" } }
            },
            "text": { "pattern": "^FAILSAFE [A-Za-z0-9][A-Za-z0-9._-]{0,63} asserted at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "failsafe-clear" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "$ref": "#/$defs/token" } }
            },
            "text": { "pattern": "^FAILSAFE [A-Za-z0-9][A-Za-z0-9._-]{0,63} cleared at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "geofence-breach" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name"],
              "properties": { "name": { "$ref": "#/$defs/token" } }
            },
            "text": { "pattern": "^GEOFENCE_BREACH [A-Za-z0-9][A-Za-z0-9._-]{0,63} at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "geofence-clear" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "text": { "pattern": "^GEOFENCE clear at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "battery-threshold" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["level"],
              "properties": { "level": { "$ref": "#/$defs/token" } }
            },
            "text": { "pattern": "^battery threshold crossed at (0|[1-9][0-9]{0,15}) us\\. level [A-Za-z0-9][A-Za-z0-9._-]{0,63}\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "link-loss" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "text": { "pattern": "^link loss recorded at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "link-restored" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            },
            "text": { "pattern": "^LINK_RESTORED at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        },
        {
          "properties": {
            "kind": { "const": "scan-summary" },
            "fields": {
              "type": "object",
              "additionalProperties": false,
              "required": ["phrase"],
              "properties": { "phrase": { "$ref": "#/$defs/phrase" } }
            },
            "text": { "pattern": "^[a-z0-9][a-z0-9 -]{0,160} at (0|[1-9][0-9]{0,15}) us\\.$" }
          }
        }
      ]
    }
  }
}

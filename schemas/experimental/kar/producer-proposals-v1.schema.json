{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knolo.dev/schema/experimental/kar/producer-proposals-v1.schema.json",
  "title": "CEG model proposals v1",
  "description": "Strict model output, format ceg-model-proposals-1. Validation turns this object into a ceg-producer-run-1 whose proposals stay PROPOSED. It is not CEG Source and it is not a sidecar.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "model", "concepts", "relations", "bindings"],
  "properties": {
    "format": { "const": "ceg-model-proposals-1" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "concepts": {
      "type": "array",
      "items": { "$ref": "#/$defs/concept" }
    },
    "relations": {
      "type": "array",
      "items": { "$ref": "#/$defs/relation" }
    },
    "bindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/binding" }
    },
    "aliases": {
      "type": "array",
      "items": { "$ref": "#/$defs/alias" }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "evidenceId"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 },
        "quote": { "type": "string" },
        "quoteDigest": { "type": "string" },
        "span": { "$ref": "#/$defs/span" },
        "confidence": { "type": "number" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "type", "to", "evidenceId"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 },
        "quote": { "type": "string" },
        "quoteDigest": { "type": "string" },
        "span": { "$ref": "#/$defs/span" },
        "confidence": { "type": "number" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concept", "evidenceId", "requirements"],
      "properties": {
        "concept": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "validFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "validUntil": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "authority": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string" },
        "quoteDigest": { "type": "string" },
        "span": { "$ref": "#/$defs/span" },
        "confidence": { "type": "number" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phrase", "concept"],
      "properties": {
        "phrase": { "type": "string", "minLength": 1 },
        "concept": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string" }
      }
    }
  }
}

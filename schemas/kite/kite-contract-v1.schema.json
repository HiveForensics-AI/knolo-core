{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knolo.dev/schemas/kite/kite-contract-v1.schema.json",
  "title": "KITE contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "question", "obligations"],
  "properties": {
    "format": { "const": "knolo-kite-contract-1" },
    "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "term"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "kind": {
            "enum": [
              "entity",
              "relation",
              "date",
              "authority",
              "qualification",
              "contradiction",
              "evidence"
            ]
          },
          "term": { "type": "string", "minLength": 3, "maxLength": 200 }
        }
      }
    }
  }
}

{
  "name": "n8n-nodes-knolo",
  "version": "0.1.0",
  "description": "n8n node for read-only Knolo search, get, and verify.",
  "license": "Apache-2.0",
  "keywords": [
    "n8n-community-node-package",
    "knolo"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiveForensics-AI/knolo-core.git",
    "directory": "packages/n8n-nodes-knolo"
  },
  "homepage": "https://github.com/HiveForensics-AI/knolo-core#readme",
  "bugs": {
    "url": "https://github.com/HiveForensics-AI/knolo-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "npm run build --workspace @knolo/core && npm run build --workspace @knolo/tools && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/Knolo/Knolo.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "dependencies": {
    "@knolo/core": "^6.2.1",
    "@knolo/tools": "^0.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "n8n-workflow": "2.47.0",
    "typescript": "^5.5.0"
  }
}

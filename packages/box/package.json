{
  "name": "@knolo/box",
  "version": "0.1.1",
  "type": "module",
  "description": "Build pinned V5 images of a Grok Bot computer and launch the read-only Knolo MCP server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HiveForensics-AI/knolo-core.git",
    "directory": "packages/box"
  },
  "homepage": "https://github.com/HiveForensics-AI/knolo-core#readme",
  "bugs": {
    "url": "https://github.com/HiveForensics-AI/knolo-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "knolo-box": "./bin/knolo-box.mjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspace @knolo/core && tsc -p tsconfig.json",
    "test": "npm run build && npm run build --workspace @knolo/tools && node --test test/box.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@knolo/core": "^6.2.1",
    "@knolo/mcp": "^0.2.3",
    "typescript": "^5.5.0"
  },
  "devDependencies": {
    "@knolo/tools": "^0.2.1",
    "@types/node": "^20.11.0"
  }
}

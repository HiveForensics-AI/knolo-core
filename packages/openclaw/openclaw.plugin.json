{
  "id": "knolo",
  "name": "Knolo",
  "description": "Verified local Knowledge Image retrieval for OpenClaw agents.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["mounts"],
    "properties": {
      "mounts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "path",
            "sha256",
            "stateRoot",
            "policyPath",
            "agents",
            "principal"
          ],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "stateRoot": {
              "type": "string",
              "pattern": "^sha256-[a-f0-9]{64}$"
            },
            "policyPath": { "type": "string", "minLength": 1 },
            "agents": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "principal": { "type": "string", "minLength": 1 }
          }
        }
      },
      "maxImageBytes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 524288000
      },
      "maxHits": { "type": "integer", "minimum": 1, "maximum": 1000 },
      "maxExcerptBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
      "maxQueryBytes": { "type": "integer", "minimum": 1, "maximum": 16384 },
      "auditDir": { "type": "string", "minLength": 1 }
    }
  },
  "contracts": {
    "tools": ["knolo_search", "knolo_get", "knolo_verify", "knolo_status"]
  },
  "skills": ["skills"]
}
